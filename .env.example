# Template for local environment variables. Copy to `.env` and edit.
# `.env` is gitignored; never commit real secrets or absolute paths.

# ----- Paths -----
# Root directory for datasets (PersonaMem-v2, paraphrase corpus, WildChat standby).
# On the H200 cluster, point this to your scratch / shared storage.
# Locally, a small checkout directory is fine for annotation tooling.
DATA_DIR=./data

# Root directory for model checkpoints. Never inside the repo.
# On H200, point to scratch storage with enough quota (tens of GB).
CHECKPOINT_DIR=./checkpoints

# Where to write training run logs, experiment outputs, analysis artifacts.
OUTPUT_DIR=./outputs

# ----- Experiment tracking -----
WANDB_PROJECT=thesis-defender
WANDB_ENTITY=           # your W&B username or team
WANDB_MODE=online       # online | offline | disabled

# ----- Hugging Face -----
HF_HOME=                # optional; redirect HF cache to a scratch location
HF_TOKEN=               # only needed for gated models; never commit real token

# ----- Reproducibility -----
SEED=42

# ----- Compute -----
# Override only if the cluster assigns a specific CUDA device.
# CUDA_VISIBLE_DEVICES=0
